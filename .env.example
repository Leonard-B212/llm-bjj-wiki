# LLM provider: openai or anthropic
LLM_PROVIDER=openai

# API keys (only the selected provider requires a key)
OPENAI_API_KEY=YourOpenAIKeyHere
ANTHROPIC_API_KEY=YourAnthropicKeyHere

# Obsidian vault
VAULT_PATH=C:\path\to\your\obsidian\vault
LANGUAGE=English

# OpenAI models
WRITER_MODEL=gpt-5.6-luna
CLASSIFIER_MODEL=gpt-4.1-mini

# Anthropic example:
# LLM_PROVIDER=anthropic
# WRITER_MODEL=claude-sonnet-4-5
# CLASSIFIER_MODEL=claude-haiku-4-5s